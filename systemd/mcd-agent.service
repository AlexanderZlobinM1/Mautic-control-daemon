[Unit]
Description=MCD Agent
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mcd
ExecStart=/opt/mcd/venv/bin/python -m mcd_agent run --config /opt/mcd/etc/mcd.toml
Restart=always
RestartSec=3
# Mautic PHP console workers are independent work and must survive an MCD
# supervisor restart/update; the restarted daemon re-adopts them from
# TaskStore. MCD-owned critical operations are protected by their own locks.
KillMode=process
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
