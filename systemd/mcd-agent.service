[Unit]
Description=MCD Agent
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mcd-agent
ExecStart=/usr/bin/python3 -m mcd_agent run --config /etc/mcd-agent.toml
Restart=always
RestartSec=3
# Mautic PHP console workers are independent work and must survive an MCD
# supervisor restart/update; the restarted daemon re-adopts them from
# TaskStore. MCD-owned critical operations are protected by their own locks.
KillMode=process
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
