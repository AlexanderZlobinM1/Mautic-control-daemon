{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plain DNS one-key Portal enrollment delivery",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_version", "identity_kind", "local_identity", "account_id", "agent_id", "commercial_key_id", "portal_api_base", "portal_agent_credential", "installation_ids"],
  "properties": {
    "schema": {"const": "mcd-portal-enrollment-material-v1"},
    "contract_version": {"const": "1.0"},
    "identity_kind": {"const": "dns"},
    "local_identity": {"type": "string", "format": "hostname"},
    "account_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "commercial_key_id": {"type": "string", "minLength": 1},
    "portal_api_base": {"type": "string", "pattern": "^https://"},
    "portal_agent_credential": {"type": "string", "minLength": 1},
    "installation_ids": {"type": "object", "minProperties": 1, "maxProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
  }
}
