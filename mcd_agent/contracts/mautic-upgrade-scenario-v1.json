{
  "schema": "mcd-mautic-upgrade-scenario-v1",
  "contract_version": "1.0",
  "capability_id": "mautic_upgrade",
  "command_id": "apply",
  "input_schema_ref": "portal://mcd/input/mautic-upgrade-apply-v1",
  "artifact": {
    "media_type": "application/json",
    "required_pin": [
      "artifact_path",
      "artifact_grant",
      "artifact_digest",
      "artifact_size_bytes",
      "artifact_media_type",
      "artifact_revision",
      "artifact_trust_mode",
      "artifact_transport",
      "trusted_catalog"
    ],
    "trust": "mcc_authenticated_api plus exact SHA-256 equality to the active MCC catalog entry"
  },
  "input": {
    "required": [
      "instance_uid"
    ],
    "source_of_upgrade_parameters": "MCD-resolved scenario artifact",
    "public_command": "The caller sends only instance_uid to the standard mautic_upgrade/apply command; this document is an internal MCD scenario contract, not a second advertised capability.",
    "command_payload_forbids": [
      "scenario_id",
      "scenario_revision",
      "scenario_artifact",
      "application_root",
      "target_version",
      "patch_plan",
      "cli_flags"
    ],
    "scenario_digest": "SHA-256 of canonical JSON with scenario_digest omitted; artifact_digest remains the SHA-256 of the complete downloaded artifact bytes"
  },
  "resolution": {
    "owner": "MCD",
    "request_schema": "portal-mcd-mautic-upgrade-scenario-resolve-request-v1",
    "request_route": "POST agents/{agent_id}/installations/{installation_id}/scenarios/resolve",
    "request": "MCD resolves operation=mautic-upgrade and instance_uid against the Portal/MCC scenario catalog using the locally observed source version",
    "response": ["status", "scenario_id", "scenario_revision", "scenario_artifact"],
    "artifact_fetch": "MCD first checks the per-instance local scenario catalog, then fetches the exact returned catalog object only when needed",
    "patch_fetch": "When MCC is reachable MCD asks the existing patch resolver, verifies every payload SHA, stages all payloads in the per-instance patches directory, and only then starts the scenario upgrade. If MCC is unavailable, the current verified local scenario runs without a new patch set."
  },
  "scenario": {
    "required": [
      "schema",
      "contract_version",
      "scenario_id",
      "scenario_revision",
      "scenario_digest",
      "instance_uid",
      "application_root",
      "source_version",
      "target_version",
      "cli",
      "post"
    ],
    "optional": ["context", "patch"],
    "cli_required": [
      "mode",
      "yes",
      "backup",
      "with_system_upgrade",
      "allow_minor",
      "allow_major",
      "allow_release_transition",
      "mcc_preflighted_single_instance"
    ],
    "patch_required_when_embedded": [
      "catalog_revision",
      "catalog_sha256",
      "plan_sha256",
      "run_id",
      "plan"
    ],
    "post_required": ["cache_clear", "inventory_rescan"]
  },
  "execution": {
    "owner": "MCD",
    "entrypoint": "mcd-cli mautic-upgrade apply",
    "implementation": "mcd_agent.mautic_upgrade.run_upgrade_apply",
    "no_second_executor": true,
    "cache_clear": "the existing MCD upgrade flow",
    "inventory_rescan": "the existing MCD inventory operation after successful apply"
  },
  "receipts": {
    "stage": "portal-mcd-generic-stage-receipt-v1",
    "terminal": "portal-mcd-generic-terminal-receipt-v1",
    "result_bindings": [
      "scenario_id",
      "scenario_revision",
      "scenario_digest",
      "instance_uid",
      "application_root",
      "source_version",
      "target_version",
      "patch_catalog_revision",
      "patch_catalog_sha256",
      "patch_plan_sha256",
      "patch_run_id",
      "cli_parameters",
      "patch.selected",
      "cache_clear",
      "final_version",
      "inventory_rescan"
    ]
  },
  "minimum_mcd_version": "1.7.33"
}
