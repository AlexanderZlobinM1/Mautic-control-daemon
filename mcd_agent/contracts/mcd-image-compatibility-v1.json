{
  "request_schema": "mcc-image-compatibility-request-v1",
  "response_schema": "mcd-image-compatibility-response-v1",
  "capability_schema": "mcd-image-compatibility-capability-v1",
  "command": "mcd-cli image-compatibility --request-json <file|-> --json",
  "read_only": true,
  "fresh_probe_required": true,
  "request_required": ["schema", "request_id", "operation", "candidates", "destination"],
  "request_operation": "add_instance",
  "candidate_required": ["image_ref", "name", "files_digest", "db_digest", "requirements"],
  "destination_required": ["domain", "root", "database", "state_key"],
  "response_status": ["compatible", "blocked", "unknown"],
  "response_compatible": "boolean; true only when every candidate is compatible",
  "blocker_status": ["observed", "unknown", "error"],
  "supported_requires": ["ipv6_disabled", "nginx", "php_fpm", "composer", "node", "npm", "certbot", "database"],
  "digest_format": "lowercase 64-character sha256 hex, optionally prefixed by canonical sha256:",
  "php_min_format": "MAJOR.MINOR; compare selected PHP-FPM version",
  "db_min_format": "object keyed by mysql/mariadb, value [major, minor, patch]; compare observed authenticated server version",
  "unknown_policy": "missing digest, missing required fact, unsupported token, probe error, or unknown DB compatibility never yields compatible",
  "sizing_fields": ["estimated_source_bytes", "files_asset_bytes", "db_asset_bytes", "source_files_bytes", "source_db_bytes"],
  "request_additional_properties": false,
  "destination_additional_properties": false,
  "candidate_additional_properties": false,
  "requirements_additional_properties": false
}
