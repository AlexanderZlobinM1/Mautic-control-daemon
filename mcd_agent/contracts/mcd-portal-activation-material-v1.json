{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCD Portal activation material delivery",
  "type": "object",
  "required": [
    "schema",
    "contract_version",
    "portal_api_base",
    "agent_id",
    "portal_agent_credential",
    "commercial_key_id",
    "installation_ids"
  ],
  "properties": {
    "schema": {"const": "mcd-portal-activation-material-v1"},
    "contract_version": {"const": "1.0"},
    "portal_api_base": {"type": "string", "pattern": "^https://"},
    "agent_id": {"type": "string", "minLength": 1},
    "portal_agent_credential": {"type": "string", "minLength": 1},
    "host_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "commercial_key_id": {"type": "string", "minLength": 1},
    "installation_ids": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "portal_artifact_trust_v1": {"type": "object", "minProperties": 1},
    "portal_registration_id": {"type": "string"},
    "commercial_key_metadata": {"type": "object"}
  },
  "additionalProperties": true
}
